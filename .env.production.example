# Warsaw Pool Ranking - Production Environment Variables
# Copy this file to .env.production and set secure values

# Admin Panel Password
# SECURITY: Use a strong, unique password!
# Generate with: openssl rand -base64 32
ADMIN_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Database path
DATABASE_PATH=/app/data/warsaw_pool_ranking.db

# Rust log level (use 'warn' or 'error' in production)
RUST_LOG=warn
