# Warsaw Pool Ranking - Local Development Environment Variables
# Copy this file to .env and customize if needed

# Admin Panel Password
# SECURITY: Change this in production! Use a strong password.
ADMIN_PASSWORD=admin

# Cache directory (optional - auto-detected as backend/cache when running from root)
# CACHE_DIR=backend/cache

# Database path (optional - auto-detected as backend/data/warsaw_pool_ranking.db)
# DATABASE_PATH=backend/data/warsaw_pool_ranking.db

# Rust log level
RUST_LOG=info
